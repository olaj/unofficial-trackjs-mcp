{
  "name": "unofficial-trackjs-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for the TrackJS Data API. Read-only tools for querying JavaScript errors, error trends, and page views. Not affiliated with TrackJS.",
  "mcpName": "io.github.olaj/unofficial-trackjs-mcp",
  "license": "MIT",
  "author": "Ola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olaj/unofficial-trackjs-mcp.git"
  },
  "homepage": "https://github.com/olaj/unofficial-trackjs-mcp#readme",
  "bugs": {
    "url": "https://github.com/olaj/unofficial-trackjs-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "trackjs",
    "error-monitoring",
    "javascript-errors",
    "claude"
  ],
  "type": "module",
  "bin": {
    "unofficial-trackjs-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
